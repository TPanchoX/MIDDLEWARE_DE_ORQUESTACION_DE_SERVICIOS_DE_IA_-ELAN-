<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_InstalarModelo"
  targetNamespace="http://middleware.elan-ai/bpmn"
  exporter="Claude Code – basado en código fuente"
  exporterVersion="1.0">

  <!-- ============================================================
       PROCESO: Instalación de un modelo de IA en el middleware
       Fuente:  middleware/app/services/model_registry_service.py
                middleware/app/services/docker_lifecycle_service.py
                middleware/app/api/routes_models.py
       ============================================================ -->

  <bpmn:process id="Proc_InstalarModelo" name="Instalación de un Modelo de IA" isExecutable="false">

    <!-- ── EVENTOS DE INICIO / FIN ─────────────────────────────── -->

    <bpmn:startEvent id="Ev_Inicio" name="POST /api/v1/models/install&#10;(cliente envía archivo ZIP)">
      <bpmn:outgoing>Fl_Inicio_T1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="Ev_FinOK" name="200 OK&#10;Modelo instalado y disponible">
      <bpmn:incoming>Fl_T8_FinOK</bpmn:incoming>
      <bpmn:incoming>Fl_T5b_FinOK</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="Ev_ErrZip" name="400 Bad Request&#10;ZIP inválido o vacío">
      <bpmn:incoming>Fl_GW1_No</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_Zip"/>
    </bpmn:endEvent>

    <bpmn:endEvent id="Ev_ErrManifest" name="400 Bad Request&#10;manifest.json ausente o inválido">
      <bpmn:incoming>Fl_GW2_No</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_Manifest"/>
    </bpmn:endEvent>

    <bpmn:endEvent id="Ev_ErrArtefacto" name="400 / 409&#10;Artefacto faltante o&#10;modelo ya registrado">
      <bpmn:incoming>Fl_GW3_No</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_Artefacto"/>
    </bpmn:endEvent>

    <bpmn:endEvent id="Ev_ErrDocker" name="400 Bad Request&#10;Docker lifecycle falló&#10;(rollback completo)">
      <bpmn:incoming>Fl_Rollback_ErrDocker</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_Docker"/>
    </bpmn:endEvent>

    <!-- ── TAREAS ─────────────────────────────────────────────── -->

    <!-- T1: Leer y validar estructura del ZIP -->
    <bpmn:task id="T1" name="Leer contenido ZIP y validar&#10;entradas (_validate_zip_entries)&#10;Detectar prefijo de directorio raíz">
      <bpmn:incoming>Fl_Inicio_T1</bpmn:incoming>
      <bpmn:outgoing>Fl_T1_GW1</bpmn:outgoing>
    </bpmn:task>

    <!-- T2: Leer y parsear manifest.json -->
    <bpmn:task id="T2" name="Leer manifest.json de la raíz&#10;del ZIP y parsear JSON&#10;(_read_manifest)">
      <bpmn:incoming>Fl_GW1_Si</bpmn:incoming>
      <bpmn:outgoing>Fl_T2_GW2</bpmn:outgoing>
    </bpmn:task>

    <!-- T3: Validar artefactos + unicidad -->
    <bpmn:task id="T3" name="Validar schema Pydantic&#10;Verificar artefactos en ZIP&#10;Comprobar unicidad (model_id, version)">
      <bpmn:incoming>Fl_GW2_Si</bpmn:incoming>
      <bpmn:outgoing>Fl_T3_GW3</bpmn:outgoing>
    </bpmn:task>

    <!-- T4: Extraer ZIP y registrar -->
    <bpmn:task id="T4" name="Extraer ZIP al directorio de instalación&#10;Crear InstalledModel (status=available)&#10;Persistir registry.json">
      <bpmn:incoming>Fl_GW3_Si</bpmn:incoming>
      <bpmn:outgoing>Fl_T4_GW4</bpmn:outgoing>
    </bpmn:task>

    <!-- T5a: Guardar bootstrap manifest (sin Docker) -->
    <bpmn:task id="T5a" name="Guardar bootstrap manifest&#10;(_save_bootstrap_manifest)">
      <bpmn:incoming>Fl_GW4_No</bpmn:incoming>
      <bpmn:outgoing>Fl_T5b_FinOK</bpmn:outgoing>
    </bpmn:task>

    <!-- T6: docker build -->
    <bpmn:task id="T6" name="docker build&#10;(contexto = install_path,&#10;Dockerfile = backend/Dockerfile)">
      <bpmn:incoming>Fl_GW4_Si</bpmn:incoming>
      <bpmn:outgoing>Fl_T6_GW5</bpmn:outgoing>
    </bpmn:task>

    <!-- T7: docker run -->
    <bpmn:task id="T7" name="docker run / ensure_container&#10;(red elan-ai-shared,&#10;bind-mount /data/videos)">
      <bpmn:incoming>Fl_GW5_Si</bpmn:incoming>
      <bpmn:outgoing>Fl_T7_GW6</bpmn:outgoing>
    </bpmn:task>

    <!-- T8: Health check -->
    <bpmn:task id="T8_HC" name="Health check&#10;GET /health → esperar HTTP 200&#10;(timeout configurable, fase 1+2)">
      <bpmn:incoming>Fl_GW6_Si</bpmn:incoming>
      <bpmn:outgoing>Fl_T8HC_GW7</bpmn:outgoing>
    </bpmn:task>

    <!-- T9: Guardar bootstrap manifest (con Docker) -->
    <bpmn:task id="T9" name="Guardar bootstrap manifest&#10;(_save_bootstrap_manifest)&#10;para re-registro automático al reiniciar">
      <bpmn:incoming>Fl_GW7_Si</bpmn:incoming>
      <bpmn:outgoing>Fl_T8_FinOK</bpmn:outgoing>
    </bpmn:task>

    <!-- T_Rollback: Rollback completo -->
    <bpmn:task id="T_Rollback" name="Rollback completo&#10;• Eliminar de registry.json&#10;• Borrar directorio de instalación">
      <bpmn:incoming>Fl_GW5_No</bpmn:incoming>
      <bpmn:incoming>Fl_GW6_No</bpmn:incoming>
      <bpmn:incoming>Fl_GW7_No</bpmn:incoming>
      <bpmn:outgoing>Fl_Rollback_ErrDocker</bpmn:outgoing>
    </bpmn:task>

    <!-- ── GATEWAYS ──────────────────────────────────────────── -->

    <!-- GW1: ¿ZIP válido con archivos? -->
    <bpmn:exclusiveGateway id="GW1" name="¿ZIP válido&#10;con archivos?">
      <bpmn:incoming>Fl_T1_GW1</bpmn:incoming>
      <bpmn:outgoing>Fl_GW1_No</bpmn:outgoing>
      <bpmn:outgoing>Fl_GW1_Si</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- GW2: ¿manifest.json válido? -->
    <bpmn:exclusiveGateway id="GW2" name="¿manifest.json&#10;encontrado y válido?">
      <bpmn:incoming>Fl_T2_GW2</bpmn:incoming>
      <bpmn:outgoing>Fl_GW2_No</bpmn:outgoing>
      <bpmn:outgoing>Fl_GW2_Si</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- GW3: ¿Artefactos OK y modelo no duplicado? -->
    <bpmn:exclusiveGateway id="GW3" name="¿Artefactos presentes&#10;y modelo no registrado?">
      <bpmn:incoming>Fl_T3_GW3</bpmn:incoming>
      <bpmn:outgoing>Fl_GW3_No</bpmn:outgoing>
      <bpmn:outgoing>Fl_GW3_Si</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- GW4: ¿El paquete incluye Dockerfile? -->
    <bpmn:exclusiveGateway id="GW4" name="¿Artefacto&#10;&#34;dockerfile&#34; en manifest?">
      <bpmn:incoming>Fl_T4_GW4</bpmn:incoming>
      <bpmn:outgoing>Fl_GW4_No</bpmn:outgoing>
      <bpmn:outgoing>Fl_GW4_Si</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- GW5: ¿Build exitoso? -->
    <bpmn:exclusiveGateway id="GW5" name="¿docker build&#10;exitoso?">
      <bpmn:incoming>Fl_T6_GW5</bpmn:incoming>
      <bpmn:outgoing>Fl_GW5_No</bpmn:outgoing>
      <bpmn:outgoing>Fl_GW5_Si</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- GW6: ¿Container iniciado? -->
    <bpmn:exclusiveGateway id="GW6" name="¿Container&#10;iniciado?">
      <bpmn:incoming>Fl_T7_GW6</bpmn:incoming>
      <bpmn:outgoing>Fl_GW6_No</bpmn:outgoing>
      <bpmn:outgoing>Fl_GW6_Si</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- GW7: ¿Health check OK? -->
    <bpmn:exclusiveGateway id="GW7" name="¿HTTP 200 antes&#10;del timeout?">
      <bpmn:incoming>Fl_T8HC_GW7</bpmn:incoming>
      <bpmn:outgoing>Fl_GW7_No</bpmn:outgoing>
      <bpmn:outgoing>Fl_GW7_Si</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ── FLUJOS DE SECUENCIA ────────────────────────────────── -->

    <bpmn:sequenceFlow id="Fl_Inicio_T1"        sourceRef="Ev_Inicio"  targetRef="T1"/>
    <bpmn:sequenceFlow id="Fl_T1_GW1"           sourceRef="T1"         targetRef="GW1"/>
    <bpmn:sequenceFlow id="Fl_GW1_No"  name="No" sourceRef="GW1"       targetRef="Ev_ErrZip"/>
    <bpmn:sequenceFlow id="Fl_GW1_Si"  name="Sí" sourceRef="GW1"       targetRef="T2"/>
    <bpmn:sequenceFlow id="Fl_T2_GW2"           sourceRef="T2"         targetRef="GW2"/>
    <bpmn:sequenceFlow id="Fl_GW2_No"  name="No" sourceRef="GW2"       targetRef="Ev_ErrManifest"/>
    <bpmn:sequenceFlow id="Fl_GW2_Si"  name="Sí" sourceRef="GW2"       targetRef="T3"/>
    <bpmn:sequenceFlow id="Fl_T3_GW3"           sourceRef="T3"         targetRef="GW3"/>
    <bpmn:sequenceFlow id="Fl_GW3_No"  name="No" sourceRef="GW3"       targetRef="Ev_ErrArtefacto"/>
    <bpmn:sequenceFlow id="Fl_GW3_Si"  name="Sí" sourceRef="GW3"       targetRef="T4"/>
    <bpmn:sequenceFlow id="Fl_T4_GW4"           sourceRef="T4"         targetRef="GW4"/>
    <bpmn:sequenceFlow id="Fl_GW4_No"  name="No" sourceRef="GW4"       targetRef="T5a"/>
    <bpmn:sequenceFlow id="Fl_GW4_Si"  name="Sí" sourceRef="GW4"       targetRef="T6"/>
    <bpmn:sequenceFlow id="Fl_T5b_FinOK"        sourceRef="T5a"        targetRef="Ev_FinOK"/>
    <bpmn:sequenceFlow id="Fl_T6_GW5"           sourceRef="T6"         targetRef="GW5"/>
    <bpmn:sequenceFlow id="Fl_GW5_No"  name="No (DockerBuildError)"  sourceRef="GW5" targetRef="T_Rollback"/>
    <bpmn:sequenceFlow id="Fl_GW5_Si"  name="Sí" sourceRef="GW5"       targetRef="T7"/>
    <bpmn:sequenceFlow id="Fl_T7_GW6"           sourceRef="T7"         targetRef="GW6"/>
    <bpmn:sequenceFlow id="Fl_GW6_No"  name="No (DockerStartError)"  sourceRef="GW6" targetRef="T_Rollback"/>
    <bpmn:sequenceFlow id="Fl_GW6_Si"  name="Sí" sourceRef="GW6"       targetRef="T8_HC"/>
    <bpmn:sequenceFlow id="Fl_T8HC_GW7"         sourceRef="T8_HC"      targetRef="GW7"/>
    <bpmn:sequenceFlow id="Fl_GW7_No"  name="No (timeout)" sourceRef="GW7" targetRef="T_Rollback"/>
    <bpmn:sequenceFlow id="Fl_GW7_Si"  name="Sí (HTTP 200)" sourceRef="GW7" targetRef="T9"/>
    <bpmn:sequenceFlow id="Fl_Rollback_ErrDocker" sourceRef="T_Rollback" targetRef="Ev_ErrDocker"/>
    <bpmn:sequenceFlow id="Fl_T8_FinOK"         sourceRef="T9"         targetRef="Ev_FinOK"/>

  </bpmn:process>

  <!-- ============================================================
       DIAGRAMA INTERCHANGE – coordenadas para bpmn.io / Camunda
       ============================================================ -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_InstalarModelo">

      <!-- ── FORMAS ─────────────────────────────────────────── -->

      <!-- Inicio -->
      <bpmndi:BPMNShape id="Sh_Inicio" bpmnElement="Ev_Inicio">
        <dc:Bounds x="152" y="272" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="120" y="315" width="100" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- T1 -->
      <bpmndi:BPMNShape id="Sh_T1" bpmnElement="T1">
        <dc:Bounds x="240" y="250" width="150" height="80"/>
      </bpmndi:BPMNShape>

      <!-- GW1 -->
      <bpmndi:BPMNShape id="Sh_GW1" bpmnElement="GW1" isMarkerVisible="true">
        <dc:Bounds x="435" y="265" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="322" width="100" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Ev_ErrZip -->
      <bpmndi:BPMNShape id="Sh_ErrZip" bpmnElement="Ev_ErrZip">
        <dc:Bounds x="438" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="412" y="106" width="88" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- T2 -->
      <bpmndi:BPMNShape id="Sh_T2" bpmnElement="T2">
        <dc:Bounds x="540" y="250" width="150" height="80"/>
      </bpmndi:BPMNShape>

      <!-- GW2 -->
      <bpmndi:BPMNShape id="Sh_GW2" bpmnElement="GW2" isMarkerVisible="true">
        <dc:Bounds x="735" y="265" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="710" y="322" width="100" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Ev_ErrManifest -->
      <bpmndi:BPMNShape id="Sh_ErrManifest" bpmnElement="Ev_ErrManifest">
        <dc:Bounds x="738" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="712" y="106" width="88" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- T3 -->
      <bpmndi:BPMNShape id="Sh_T3" bpmnElement="T3">
        <dc:Bounds x="840" y="250" width="160" height="80"/>
      </bpmndi:BPMNShape>

      <!-- GW3 -->
      <bpmndi:BPMNShape id="Sh_GW3" bpmnElement="GW3" isMarkerVisible="true">
        <dc:Bounds x="1050" y="265" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1015" y="322" width="120" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Ev_ErrArtefacto -->
      <bpmndi:BPMNShape id="Sh_ErrArtefacto" bpmnElement="Ev_ErrArtefacto">
        <dc:Bounds x="1053" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1020" y="96" width="102" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- T4 -->
      <bpmndi:BPMNShape id="Sh_T4" bpmnElement="T4">
        <dc:Bounds x="1155" y="250" width="170" height="80"/>
      </bpmndi:BPMNShape>

      <!-- GW4 -->
      <bpmndi:BPMNShape id="Sh_GW4" bpmnElement="GW4" isMarkerVisible="true">
        <dc:Bounds x="1375" y="265" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1340" y="322" width="120" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- T5a (sin Docker) -->
      <bpmndi:BPMNShape id="Sh_T5a" bpmnElement="T5a">
        <dc:Bounds x="1350" y="430" width="160" height="70"/>
      </bpmndi:BPMNShape>

      <!-- T6 docker build -->
      <bpmndi:BPMNShape id="Sh_T6" bpmnElement="T6">
        <dc:Bounds x="1480" y="250" width="150" height="80"/>
      </bpmndi:BPMNShape>

      <!-- GW5 -->
      <bpmndi:BPMNShape id="Sh_GW5" bpmnElement="GW5" isMarkerVisible="true">
        <dc:Bounds x="1680" y="265" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1655" y="322" width="100" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- T7 docker run -->
      <bpmndi:BPMNShape id="Sh_T7" bpmnElement="T7">
        <dc:Bounds x="1785" y="250" width="150" height="80"/>
      </bpmndi:BPMNShape>

      <!-- GW6 -->
      <bpmndi:BPMNShape id="Sh_GW6" bpmnElement="GW6" isMarkerVisible="true">
        <dc:Bounds x="1985" y="265" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1960" y="322" width="100" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- T8 health check -->
      <bpmndi:BPMNShape id="Sh_T8HC" bpmnElement="T8_HC">
        <dc:Bounds x="2090" y="250" width="150" height="80"/>
      </bpmndi:BPMNShape>

      <!-- GW7 -->
      <bpmndi:BPMNShape id="Sh_GW7" bpmnElement="GW7" isMarkerVisible="true">
        <dc:Bounds x="2290" y="265" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2265" y="322" width="100" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- T9 bootstrap manifest (con Docker) -->
      <bpmndi:BPMNShape id="Sh_T9" bpmnElement="T9">
        <dc:Bounds x="2395" y="250" width="160" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Ev_FinOK -->
      <bpmndi:BPMNShape id="Sh_FinOK" bpmnElement="Ev_FinOK">
        <dc:Bounds x="2612" y="272" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2586" y="315" width="88" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- T_Rollback -->
      <bpmndi:BPMNShape id="Sh_Rollback" bpmnElement="T_Rollback">
        <dc:Bounds x="1850" y="430" width="180" height="70"/>
      </bpmndi:BPMNShape>

      <!-- Ev_ErrDocker -->
      <bpmndi:BPMNShape id="Sh_ErrDocker" bpmnElement="Ev_ErrDocker">
        <dc:Bounds x="2083" y="447" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2050" y="490" width="102" height="54"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- ── ARISTAS ─────────────────────────────────────────── -->

      <bpmndi:BPMNEdge id="Ed_Inicio_T1" bpmnElement="Fl_Inicio_T1">
        <di:waypoint x="188" y="290"/>
        <di:waypoint x="240" y="290"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_T1_GW1" bpmnElement="Fl_T1_GW1">
        <di:waypoint x="390" y="290"/>
        <di:waypoint x="435" y="290"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_GW1_No" bpmnElement="Fl_GW1_No">
        <di:waypoint x="460" y="265"/>
        <di:waypoint x="460" y="178"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="466" y="215" width="15" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_GW1_Si" bpmnElement="Fl_GW1_Si">
        <di:waypoint x="485" y="290"/>
        <di:waypoint x="540" y="290"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="500" y="272" width="13" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_T2_GW2" bpmnElement="Fl_T2_GW2">
        <di:waypoint x="690" y="290"/>
        <di:waypoint x="735" y="290"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_GW2_No" bpmnElement="Fl_GW2_No">
        <di:waypoint x="760" y="265"/>
        <di:waypoint x="760" y="178"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="766" y="215" width="15" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_GW2_Si" bpmnElement="Fl_GW2_Si">
        <di:waypoint x="785" y="290"/>
        <di:waypoint x="840" y="290"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="272" width="13" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_T3_GW3" bpmnElement="Fl_T3_GW3">
        <di:waypoint x="1000" y="290"/>
        <di:waypoint x="1050" y="290"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_GW3_No" bpmnElement="Fl_GW3_No">
        <di:waypoint x="1075" y="265"/>
        <di:waypoint x="1075" y="178"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1081" y="215" width="15" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_GW3_Si" bpmnElement="Fl_GW3_Si">
        <di:waypoint x="1100" y="290"/>
        <di:waypoint x="1155" y="290"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1115" y="272" width="13" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_T4_GW4" bpmnElement="Fl_T4_GW4">
        <di:waypoint x="1325" y="290"/>
        <di:waypoint x="1375" y="290"/>
      </bpmndi:BPMNEdge>

      <!-- GW4 No → T5a (hacia abajo) -->
      <bpmndi:BPMNEdge id="Ed_GW4_No" bpmnElement="Fl_GW4_No">
        <di:waypoint x="1400" y="315"/>
        <di:waypoint x="1400" y="465"/>
        <di:waypoint x="1350" y="465"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1406" y="383" width="15" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Ed_GW4_Si" bpmnElement="Fl_GW4_Si">
        <di:waypoint x="1425" y="290"/>
        <di:waypoint x="1480" y="290"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1440" y="272" width="13" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- T5a → FinOK (flujo largo por debajo) -->
      <bpmndi:BPMNEdge id="Ed_T5b_FinOK" bpmnElement="Fl_T5b_FinOK">
